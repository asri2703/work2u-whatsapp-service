# Work2U WhatsApp Service Configuration

# Server
PORT=3000

# API Key for authenticating with Work2U CRM
# Generate a strong random key
API_KEY=work2u_secret_change_me_in_production

# Work2U CRM webhook URL (where to send incoming messages)
# Example: https://crm.work2u.io/api/whatsapp/webhook
WEBHOOK_URL=https://crm.work2u.io/api/whatsapp/webhook
WEBHOOK_SECRET=work2u_webhook_secret_change_me

# WhatsApp session storage path (default: ./auth)
AUTH_PATH=./auth

# Rate limiting (max messages per minute per recipient)
RATE_LIMIT=30
